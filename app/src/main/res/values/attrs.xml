<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局强调色：默认指向品牌绿，强调色主题覆盖层可在此覆盖 -->
    <attr name="auroraAccent" format="color" />

    <!-- 强调色之上的前景色（强调色作背景时的文字/图标色），由覆盖层按明度给出，避免白字白底 -->
    <attr name="auroraOnAccent" format="color" />

    <!-- 表面类颜色故意走主题属性：AMOLED 覆盖层需要把它们改成纯黑，
         而直接引用 @color/ 的资源无法在运行时被覆盖层改写。 -->
    <attr name="auroraCard" format="color" />
    <attr name="auroraBackgroundElevated" format="color" />
    <attr name="auroraFill" format="color" />

    <!--
      文字色三级 + 分隔线。与上面三个表面色同理必须走属性：它们是「被覆盖层和
      深浅色同时改写」的量，写 @color/ 就等于把值焊死在布局里。

      为什么这四个槽位之前不存在，值得记一笔：项目历史上并排长出了五代配色
      （stitch → explore → fluent → ios → aurora），每一代只新增不迁移，
      于是「主文字色」一个语义在三个页面是三个不同的值 ——
      ios_text_primary(#000000) / explore_slate_800(#1E293B) / fluent_on_surface(#2D2F32)，
      设备页甚至还有 5 处硬编码 #16181C。翻页时「这一页偏灰、那一页偏蓝」
      就是这么来的，不是设计问题，是没有可以指的槽位。
      深色模式下更糟：硬编码的那几处在黑底上直接不可读。

      收口后：改文字色只改一处；新的覆盖层（AMOLED 之类）能一次性改写；
      布局里不再出现任何具体色值。
    -->
    <attr name="auroraTextPrimary" format="color" />
    <attr name="auroraTextSecondary" format="color" />
    <attr name="auroraTextTertiary" format="color" />
    <attr name="auroraSeparator" format="color" />

    <declare-styleable name="CpuRingGaugeView">
        <attr name="gaugeStyle" format="enum">
            <enum name="semi" value="0" />
            <enum name="donut" value="1" />
        </attr>
    </declare-styleable>

    <!-- 限高滚动容器的上限。两种给法，二选一；都不写则按屏高的默认比例
         （见 MaxHeightScrollView）。dimension 适合「上下还有固定内容」的场合，
         fraction 适合「只想占多少屏高」的场合。 -->
    <declare-styleable name="MaxHeightScrollView">
        <attr name="auroraMaxHeight" format="dimension" />
        <attr name="auroraMaxHeightFraction" format="float" />
    </declare-styleable>
</resources>
