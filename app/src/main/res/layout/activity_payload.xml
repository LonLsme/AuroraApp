<?xml version="1.0" encoding="utf-8"?>
<!--
  Payload 解包页（竖屏，独立 Activity）。

  <p>版式是固定的 2D 扁平工具面板：白底、细灰边框、无渐变、无阴影、无卡片投影。
  颜色一律写字面色值而不是 @color/ 或 ?attr/ ——
  项目其它页面跟随主题与 AMOLED 覆盖层，这一页按需求固定白底，混用会让深色模式下半黑半白。

  <p>自上而下四段，顺序固定：
  <ol>
    <li>顶栏（返回 + 标题）；</li>
    <li>两行表单：路径/URL、输出路径，各带一个浅蓝文件夹按钮；</li>
    <li>三个并列主操作 + 分区表标题 + 筛选框 + 三列表格（占满剩余高度，内部滚动）；</li>
    <li>底部进度区（百分比 / 速度 / 剩余时间）。</li>
  </ol>

  <p>表格区用 weight 吃掉剩余高度而不是写死 dp：小屏剩得少、大屏剩得多，
  表格自己内部滚动，进度条永远钉在底部不会被挤走。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ───────── 顶栏 ───────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnPayloadBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tint="#2B2F36" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Payload 解包"
            android:textColor="#16181C"
            android:textSize="17sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

    <!-- ───────── 两行表单 ───────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="路径/URL"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPayloadPath"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_payload_input"
                android:hint="支持本地/云端全量包_欧加散包_无需解压直接提取"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#16181C"
                android:textColorHint="#A6AEBB"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnPickPayloadFile"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_payload_button_light"
                android:clickable="true"
                android:drawableStart="@drawable/ic_folder_open"
                android:drawablePadding="4dp"
                android:drawableTint="#2F6BFF"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="选择"
                android:textColor="#2F6BFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="输出路径"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPayloadOutput"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_payload_input"
                android:hint="请选择解包后文件的保存路径文件夹..."
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#16181C"
                android:textColorHint="#A6AEBB"
                android:textSize="12.5sp" />

            <!--
              输出路径的按钮只用图标（输入框已经占满宽度，再加文字会挤）。
              用 ImageView 而不是带 drawableStart 的 TextView：
              没有文字时 compound drawable 会贴在内容区左缘，居中不了。
            -->
            <ImageView
                android:id="@+id/btnPickPayloadOutput"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_payload_button_light"
                android:clickable="true"
                android:contentDescription="选择输出文件夹"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_folder_open"
                android:tint="#2F6BFF" />
        </LinearLayout>

        <!-- 三个并列操作：读取信息（主）/ 提取镜像 / 停止操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPayloadRead"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_payload_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="读取信息"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/btnPayloadExtract"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_payload_button_light"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="提取镜像"
                android:textColor="#2F6BFF"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/btnPayloadStop"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_payload_button_light"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="停止操作"
                android:textColor="#2F6BFF"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ───────── 分区表 ───────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="分区表"
        android:textColor="#16181C"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPayloadFilter"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_payload_input"
        android:hint="筛选分区名称"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="#16181C"
        android:textColorHint="#A6AEBB"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_payload_table"
        android:orientation="vertical">

        <!-- 表头：复选框（全选）| 分区名称 | 分区大小 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_payload_table_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <CheckBox
                android:id="@+id/cbPayloadSelectAll"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:buttonTint="#2F6BFF"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="分区名称"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="分区大小"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E7EC" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPayloadPartitions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="always"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- ───────── 底部进度区 ───────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPayloadStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="就绪"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPayloadPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="0%"
                android:textColor="#2F6BFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbPayload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_payload_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPayloadSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="速度 —"
                android:textColor="#9AA3AF"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPayloadEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剩余 —"
                android:textColor="#9AA3AF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
