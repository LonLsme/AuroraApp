<?xml version="1.0" encoding="utf-8"?>
<!--
  更新下载进度对话框。
  四种形态共用同一套控件，由 UpdateDownloadDialog 决定显隐：
    下载中  — 进度条 + 「已下载 / 总大小 · 速度」，按钮 [取消]
    校验中  — 进度条满格 + 「正在校验…」
    已就绪  — 进度条满格 + 「校验通过 · SHA-256 前 12 位」，按钮 [稍后] [安装]
    失败    — 进度条清空 + 具体原因，按钮 [关闭] [手动下载]
  副文本行给 minLines=2：进度文案从「1.2 MB/s」变成「校验通过」时高度不跳。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDlIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_update"
            android:tint="?attr/auroraAccent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDlTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="正在下载更新"
                android:textColor="@color/ios_text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvDlVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/ios_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbDl"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="18dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_update" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDlStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"
            android:minLines="2"
            android:textColor="@color/ios_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDlPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/auroraAccent"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDlVerify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDlCancel"
            style="@style/Widget.Aurora.Miuix.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDlInstall"
            style="@style/Widget.Aurora.Miuix.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="安装"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
