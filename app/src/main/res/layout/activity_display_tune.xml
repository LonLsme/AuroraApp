<?xml version="1.0" encoding="utf-8"?>
<!--
  「屏幕」调节页：分辨率 / 密度 / 刷新率 / 刷新率实测。

  安全相关控件（保留更改按钮 + 倒计时条）放在最外层 CoordinatorLayout 底部，
  不随内容滚动 —— 必须保证任何滚动位置下都能立刻点到「保留更改」，
  否则用户改完分辨率后 UI 变形、按钮滚出视野就彻底救不回来了。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background_grouped"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarDisplayTune"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/auroraBackgroundElevated"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDisplayTune"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="屏幕"
            app:titleTextColor="@color/ios_text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDisplayTune"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ios_screen_edge"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ───────── 状态总览 ───────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/auroraCard"
                app:cardCornerRadius="@dimen/ios_card_corner"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ios_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="屏幕状态"
                        android:textAppearance="@style/Widget.IOS.SubsectionTitle" />

                    <TextView
                        android:id="@+id/tvDisplayRootStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="检测中…"
                        android:textAppearance="@style/Widget.IOS.Body" />

                    <TextView
                        android:id="@+id/tvDisplaySizeSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="—"
                        android:textAppearance="@style/Widget.IOS.Body" />

                    <TextView
                        android:id="@+id/tvDisplayRateSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="—"
                        android:textAppearance="@style/Widget.IOS.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisplayRefresh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="重新检测"
                        android:textAllCaps="false"
                        android:textColor="@color/ios_text_primary"
                        app:backgroundTint="?attr/auroraBackgroundElevated"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/ios_separator"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ───────── 刷新率 ───────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ios_section_gap"
                app:cardBackgroundColor="?attr/auroraCard"
                app:cardCornerRadius="@dimen/ios_card_corner"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ios_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="刷新率"
                        android:textAppearance="@style/Widget.IOS.SubsectionTitle" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupRefreshModes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="恢复系统自适应刷新率"
                        android:textAllCaps="false"
                        android:textColor="@color/ios_text_primary"
                        app:backgroundTint="?attr/auroraBackgroundElevated"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/ios_separator"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ───────── 分辨率 ───────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ios_section_gap"
                app:cardBackgroundColor="?attr/auroraCard"
                app:cardCornerRadius="@dimen/ios_card_corner"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ios_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="分辨率与密度"
                        android:textAppearance="@style/Widget.IOS.SubsectionTitle" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupSizePresets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp"
                        app:singleSelection="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="@color/ios_separator">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDisplayWidth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="宽"
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:maxLines="1"
                                android:textColor="@color/ios_text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="@color/ios_separator">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDisplayHeight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="高"
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:maxLines="1"
                                android:textColor="@color/ios_text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="0.9"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="@color/ios_separator">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDisplayDensity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="密度"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLines="1"
                                android:textColor="@color/ios_text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplySize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="应用分辨率"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetSize"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="还原为物理分辨率"
                        android:textAllCaps="false"
                        android:textColor="@color/ios_text_primary"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/ios_separator" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ───────── 刷新率实测 ───────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ios_section_gap"
                app:cardBackgroundColor="?attr/auroraCard"
                app:cardCornerRadius="@dimen/ios_card_corner"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ios_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="刷新率实测"
                        android:textAppearance="@style/Widget.IOS.SubsectionTitle" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupTestDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRunTest"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="开始测试"
                            android:textAllCaps="false"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStopTest"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="停止"
                            android:textAllCaps="false"
                            android:textColor="@color/ios_text_primary"
                            android:visibility="gone"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/ios_separator"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressTest"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tvTestResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="尚未测试"
                        android:textAppearance="@style/Widget.IOS.Body" />

                    <TextView
                        android:id="@+id/tvTestVerdict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textAppearance="@style/Widget.IOS.Caption" />

                    <!-- 供测试期间持续 invalidate 用：有真实绘制才会稳定收到 vsync -->
                    <View
                        android:id="@+id/viewPulse"
                        android:layout_width="24dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="10dp"
                        android:background="?attr/auroraAccent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ───────── 未确认改动：底部常驻确认条（不随内容滚动） ───────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardConfirmBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/ios_screen_edge"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/auroraBackgroundElevated"
        app:cardCornerRadius="@dimen/ios_card_corner"
        app:cardElevation="8dp"
        app:strokeColor="@color/ios_separator"
        app:strokeWidth="0.5dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progressCountdown"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ios_card_padding"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCountdownTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="显示设置有变动"
                        android:textAppearance="@style/Widget.IOS.SubsectionTitle" />

                    <TextView
                        android:id="@+id/tvCountdownDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="15 秒后自动还原"
                        android:textAppearance="@style/Widget.IOS.Caption" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKeepChanges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="保留"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
