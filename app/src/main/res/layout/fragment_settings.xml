<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（原生设置范式）。

  版式约定（改版时请保持）：
    1) 整页只有一个层级：分组小标题 + 单个圆角表面（bg_settings_group），
       **不再给每一行套卡片** —— 逐项卡片会带来重复的圆角、阴影和间距噪音；
    2) 行 = 24dp 线条图标 + 16sp 主色标题 + 行尾「当前值 / 轻量箭头」，
       三者统一 center_vertical，行最小高 56dp，左右内边距 16dp；
    3) 行与行之间只有一条 0.5dp 细线，且**从标题处缩进**（16 + 24 + 16 = 56dp），
       末端也留 16dp，视觉上不顶到卡片边缘；
    4) 点击整个行触发交互（foreground 用 selectableItemBackground 提供轻柔水波纹），
       不允许只有文字或小图标可点；
    5) 图标一律单色描边、统一 24dp，由 ?attr/auroraTextPrimary 着色 ——
       不用彩色图标、不用渐变、不加装饰元素。

  颜色全部走语义属性 / 语义色，浅色为极浅灰底 + 白卡片，深色为舒适深灰底 + 深灰卡片
  （见 colors.xml 的 settings_page_background，刻意避开纯黑）。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_page_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="always"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- 页面大标题（顶栏已收起，这里是全页唯一的一级标题） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="设置"
            android:textColor="?attr/auroraTextPrimary"
            android:textSize="30sp" />

        <!-- ═══════════════ 通用 ═══════════════ -->
        <TextView
            style="@style/Widget.Aurora.Settings.GroupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="8dp"
            android:text="通用" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_settings_group"
            android:orientation="vertical">

            <!-- 开关行：自动检查更新 -->
            <LinearLayout
                android:id="@+id/rowCheckUpdateAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowIcon"
                    android:src="@drawable/ic_settings_refresh" />

                <TextView
                    style="@style/Widget.Aurora.Settings.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="自动检查更新" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swCheckUpdate"
                    style="@style/Widget.Aurora.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/auroraSeparator" />

            <!-- 动作行：立即检查更新（行尾显示当前版本 / 待安装） -->
            <LinearLayout
                android:id="@+id/rowCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowIcon"
                    android:src="@drawable/ic_settings_download" />

                <TextView
                    style="@style/Widget.Aurora.Settings.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="检查更新" />

                <TextView
                    android:id="@+id/tvUpdateValue"
                    style="@style/Widget.Aurora.Settings.RowValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="--" />

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowTrailingIcon"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════ 外观 ═══════════════ -->
        <TextView
            style="@style/Widget.Aurora.Settings.GroupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="8dp"
            android:text="外观" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_settings_group"
            android:orientation="vertical">

            <!-- 可选项：主题色（弹选择菜单） -->
            <LinearLayout
                android:id="@+id/rowThemeMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowIcon"
                    android:src="@drawable/ic_settings_palette" />

                <TextView
                    style="@style/Widget.Aurora.Settings.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="主题色" />

                <TextView
                    android:id="@+id/tvThemeModeValue"
                    style="@style/Widget.Aurora.Settings.RowValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="跟随系统" />

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowTrailingIcon"
                    android:src="@drawable/ic_chevron_updown" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/auroraSeparator" />

            <!-- 可选项：界面字号（弹选择菜单） -->
            <LinearLayout
                android:id="@+id/rowFontScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowIcon"
                    android:src="@drawable/ic_settings_font" />

                <TextView
                    style="@style/Widget.Aurora.Settings.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="界面字号" />

                <TextView
                    android:id="@+id/tvFontScaleValue"
                    style="@style/Widget.Aurora.Settings.RowValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="100%" />

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowTrailingIcon"
                    android:src="@drawable/ic_chevron_updown" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/auroraSeparator" />

            <!-- 可选项：底栏效果（互斥三档，弹选择菜单） -->
            <LinearLayout
                android:id="@+id/rowBarEffect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowIcon"
                    android:src="@drawable/ic_settings_glass" />

                <TextView
                    style="@style/Widget.Aurora.Settings.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="底栏效果" />

                <TextView
                    android:id="@+id/tvBarEffectValue"
                    style="@style/Widget.Aurora.Settings.RowValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="液态玻璃" />

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowTrailingIcon"
                    android:src="@drawable/ic_chevron_updown" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/auroraSeparator" />

            <!-- 开关行：滑动切换导航页面 -->
            <LinearLayout
                android:id="@+id/rowSwipeTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowIcon"
                    android:src="@drawable/ic_settings_swipe" />

                <TextView
                    style="@style/Widget.Aurora.Settings.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="滑动切换导航页面" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swSwipeTabs"
                    style="@style/Widget.Aurora.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minHeight="28dp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════ 关于 ═══════════════ -->
        <TextView
            style="@style/Widget.Aurora.Settings.GroupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="8dp"
            android:text="关于" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_settings_group"
            android:orientation="vertical">

            <!-- 跳转行：关于 Aurora（行尾显示版本号） -->
            <LinearLayout
                android:id="@+id/rowAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowIcon"
                    android:src="@drawable/ic_settings_info" />

                <TextView
                    style="@style/Widget.Aurora.Settings.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="关于 Aurora" />

                <TextView
                    android:id="@+id/tvAboutValue"
                    style="@style/Widget.Aurora.Settings.RowValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="--" />

                <ImageView
                    style="@style/Widget.Aurora.Settings.RowTrailingIcon"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
