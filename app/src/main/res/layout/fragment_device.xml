<?xml version="1.0" encoding="utf-8"?>
<!--
  设备概览页。

  结构只有两块：
    ① cardDeviceOverview —— 设备概览卡片（本机与外接设备共用这一张，靠标题右侧的下拉换数据源）
    ② cardCpu            —— CPU 状态卡片

  没有「去授权」之类的引导卡：特权字段读不到就显示「—」，页面照常展示能读到的部分。

  为什么外接设备不另开一张卡片：两者字段完全一样，摆两套视图会让同一屏出现两份
  「设备概览」，还要各自刷新、各自处理读不到的情况。共用一套、只换数据源，
  页面里永远只有一份设备信息。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fluent_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="always"
    android:paddingBottom="88dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/deviceContentContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="spread"
            app:layout_constraintWidth_max="900dp">

            <!-- ═══════ ① 设备概览 ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeviceOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/fluent_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/fluent_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- 标题行：左边「设备概览 / 机型 / 代号」，右端是数据源下拉 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="设备概览"
                                    android:textAllCaps="true"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDeviceName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/fluent_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="OPPO PJX110" />

                                <TextView
                                    android:id="@+id/tvDeviceCode"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="11sp"
                                    tools:text="设备代号: PJX110" />
                            </LinearLayout>

                            <!-- 数据源下拉触发器：位置固定在标题右侧，不悬浮、不置顶 -->
                            <LinearLayout
                                android:id="@+id/btnDeviceSource"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_flash_device_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="6dp">

                                <TextView
                                    android:id="@+id/tvDeviceSource"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxWidth="120dp"
                                    android:singleLine="true"
                                    android:text="本机"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="13sp"
                                    tools:text="本机" />

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_chevron_down"
                                    app:tint="?attr/auroraTextSecondary" />
                            </LinearLayout>
                        </LinearLayout>

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:columnCount="2"
                            android:rowCount="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_marginBottom="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="系统版本"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="11sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="4dp"
                                        android:importantForAccessibility="no"
                                        app:srcCompat="@drawable/ic_device_info"
                                        app:tint="@color/fluent_android_green" />

                                    <TextView
                                        android:id="@+id/tvAndroidVersion"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="?attr/auroraTextPrimary"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        tools:text="Android 16 (API 36)" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginBottom="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="内核版本"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvKernelVersion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="6.1.118-android15-11" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SELinux"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvSelinuxStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="强制模式" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="当前 Slot"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvBootSlot"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="A 槽位" />
                            </LinearLayout>

                            <!--
                              BL 状态：跨两列单独占一行。
                              它和「当前 Slot」是一组（都在讲分区与启动），放一行里并排会把
                              「已锁定 · 自签名」这种较长的值挤成两行，所以给满宽。
                            -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnSpan="2"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="BL 状态"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvBootloaderState"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="已解锁" />
                            </LinearLayout>
                        </GridLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/fluent_surface_container" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:columnCount="2"
                            android:useDefaultMargins="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="68dp"
                                android:layout_columnSpan="2"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/fluent_cell_bg"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="系统版本"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvBuildDisplay"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="monospace"
                                    android:maxLines="3"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="PJX110_15.0.0.300(CN01)" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="68dp"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="6dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/fluent_cell_bg"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="安全补丁日期"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvSecurityPatch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="monospace"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="2025-01-05" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="68dp"
                                android:layout_columnWeight="1"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/fluent_cell_bg"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="基带版本"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvRadioVersion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="monospace"
                                    android:maxLines="3"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="Q_V1_P14,Q_V1_P14" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="68dp"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="6dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/fluent_cell_bg"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="安卓 ID"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvAndroidId"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="monospace"
                                    android:maxLines="3"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="a1b2c3d4e5f6g7h8" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="68dp"
                                android:layout_columnWeight="1"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/fluent_cell_bg"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="电池循环次数"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvBatteryCycles"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="monospace"
                                    android:maxLines="3"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="333" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="96dp"
                                android:layout_columnSpan="2"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill_horizontal"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/fluent_cell_bg"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="构建指纹"
                                    android:textColor="?attr/auroraTextSecondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvBuildFingerprint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="monospace"
                                    android:maxLines="4"
                                    android:textColor="?attr/auroraTextPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="google/oriole/oriole:16/BP1A.250405.007/1234567:user/release-keys" />
                            </LinearLayout>
                        </GridLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ ② CPU 状态 ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/fluent_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/fluent_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ms_developer_board"
                            app:tint="@color/fluent_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="CPU 状态"
                            android:textAllCaps="true"
                            android:textColor="?attr/auroraTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/fluent_cell_bg"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <GridLayout
                            android:id="@+id/llCpuCoreRings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:alignmentMode="alignBounds"
                            android:clipChildren="false"
                            android:columnCount="4"
                            android:orientation="horizontal"
                            android:useDefaultMargins="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
