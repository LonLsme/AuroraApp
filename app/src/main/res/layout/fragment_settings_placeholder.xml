<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentSettingsPlaceholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 设置页本体由 MainActivity.installPageFragments() 在容器可达后添加。
         此处刻意不写 android:name —— 静态声明的 Fragment 在 Activity 重建时只能靠
         「容器 id + findViewById」恢复，而本容器随页面 View 被 ViewPager2 托管，
         恢复时机早于 ViewPager2 布局完成，会定位不到容器导致整页空白。 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/settingsFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
