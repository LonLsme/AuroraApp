<?xml version="1.0" encoding="utf-8"?>
<!-- 进程管理列表项：图标 + 友好名/进程名 + PID/CPU/内存 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ios_screen_edge"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/auroraCard"
    app:cardCornerRadius="@dimen/ios_card_corner"
    app:cardElevation="0dp"
    app:strokeColor="@color/ios_glass_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivProcessIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="进程图标"
            android:scaleType="centerInside"
            android:src="@drawable/ic_process_linux" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProcessFriendlyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/ios_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProcessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ios_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProcessPid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ios_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvProcessCpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/explore_amber_600"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvProcessMem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ios_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
