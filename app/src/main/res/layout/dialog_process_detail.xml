<?xml version="1.0" encoding="utf-8"?>
<!-- 进程详情对话框：头部 + 滚动详情 + 操作按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/auroraBackgroundElevated"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 头部：图标 + 友好名 + 进程名 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDetailIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="进程图标"
            android:src="@drawable/ic_process_linux" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailFriendlyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/ios_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDetailProcessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ios_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginVertical="14dp"
        android:background="@color/ios_separator" />

    <!-- 详情键值对（代码动态填充）。
         上限必须靠自定义控件给：android:maxHeight 是 ImageView 的属性，
         ScrollView 不认，写了等于没写，行数一多就把对话框撑出屏幕。 -->
    <com.aurora.app.ui.widget.MaxHeightScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        app:auroraMaxHeight="340dp">

        <LinearLayout
            android:id="@+id/layoutProcessDetailRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.aurora.app.ui.widget.MaxHeightScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailStopApp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="停止应用"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="10dp"
            android:textColor="@color/white"
            app:backgroundTint="#D93025"
            app:rippleColor="#33FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailKill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="结束进程"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            android:textColor="@color/white"
            app:backgroundTint="#F59E0B"
            app:rippleColor="#33FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            android:textColor="@color/ios_text_primary"
            app:backgroundTint="?attr/auroraFill"
            app:rippleColor="#22000000" />
    </LinearLayout>
</LinearLayout>
