<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="?attr/auroraCard"
    app:cardCornerRadius="@dimen/ios_card_corner"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ios_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClusterName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CPU0-3"
                android:textAppearance="@style/Widget.IOS.SubsectionTitle" />

            <TextView
                android:id="@+id/tvClusterCurFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1805 MHz"
                android:textColor="?attr/auroraAccent"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvClusterSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="调度器 schedutil"
            android:textAppearance="@style/Widget.IOS.Caption" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:background="@color/ios_separator" />

        <LinearLayout
            android:id="@+id/layoutClusterFreq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最低频率"
                    android:textAppearance="@style/Widget.IOS.Body"
                    android:textColor="@color/ios_text_secondary" />

                <TextView
                    android:id="@+id/tvClusterMinFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="806 MHz"
                    android:textAppearance="@style/Widget.IOS.Body" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekClusterMin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/ios_separator"
                android:progressTint="@color/explore_blue_600"
                android:thumbTint="@color/explore_blue_600" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最高频率"
                    android:textAppearance="@style/Widget.IOS.Body"
                    android:textColor="@color/ios_text_secondary" />

                <TextView
                    android:id="@+id/tvClusterMaxFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1805 MHz"
                    android:textAppearance="@style/Widget.IOS.Body" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekClusterMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/ios_separator"
                android:progressTint="@color/explore_blue_600"
                android:thumbTint="@color/explore_blue_600" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvClusterNoFreq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="该集群未暴露可用频率表，仅支持切换调度器"
            android:textAppearance="@style/Widget.IOS.Caption"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutClusterGovernors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
