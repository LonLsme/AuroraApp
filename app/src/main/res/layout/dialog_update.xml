<?xml version="1.0" encoding="utf-8"?>
<!--
  检查更新对话框。

  同一个窗口承担四种形态，由 UpdateDialog 切换显隐，不换布局、不新开窗口：
    · 检查中     —— 顶部旋转环 + 「正在检查更新」，按钮区整体收起
    · 发现新版本 —— 图标 + 版本对比 + 更新日志，[稍后] [立即更新] 并排等宽
    · 已是最新   —— 图标 + 「已是最新版本」+ 一句副文案，[知道了] 单按钮铺满整行
    · 检查失败   —— 图标 + 失败原因，[知道了] [手动查看]

  版式取「居中字体块 + 底部等宽按钮」：标题、副文案、版本对比全部居中；
  按钮用 weight 平分卡片宽度，单按钮形态靠 weight 自然铺满，不必为「已是最新」另写一套布局。

  ★ 结构必须是「顶部固定 / 中间可滚 / 按钮固定」三段，按钮绝不能进滚动区：
  按钮跟着正文一起滚，正文一长它就滚出视野 —— 看起来就是「根本没有按钮」。

  ★ 中间区的上限只能靠 MaxHeightScrollView 给。android:maxHeight 是 ImageView
  的属性，ScrollView 不认、静默忽略，写了等于没写（本文件的历史踩坑）。
  这里用 app:auroraMaxHeightFraction="0.42"：正文最多占 42% 屏高，剩下的留给
  头部与按钮，整张卡片在任何屏高下都不会顶出屏幕。

  ★ 图标与旋转环共用一个 64dp 见方的 FrameLayout：两种形态占同一块空间，
  切换时标题不会上下跳。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <!-- 顶部视觉：结果态是图标，检查中是旋转环 -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivUpdateIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_update"
            app:tint="?attr/auroraAccent" />

        <ProgressBar
            android:id="@+id/pbUpdateLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/auroraAccent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 标题：居中、加粗；四种形态都走这一行 -->
    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="正在检查更新"
        android:textColor="?attr/auroraTextPrimary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <!-- 版本对比（仅有新版本时出现） -->
    <TextView
        android:id="@+id/tvUpdateVersions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="?attr/auroraTextSecondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 中间：限高滚动区（状态说明与更新日志都放这里，长短都撑不破卡片） -->
    <com.aurora.app.ui.widget.MaxHeightScrollView
        android:id="@+id/svUpdateBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="always"
        android:scrollbars="vertical"
        android:visibility="gone"
        app:auroraMaxHeightFraction="0.42">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 一句话状态：已是最新 / 失败原因，都在这里，居中。
                 下方间距用自身的 paddingBottom 而不是下面那行的 marginTop：
                 它 gone 时（有新版本，只有正文）不会留下空白。 -->
            <TextView
                android:id="@+id/tvUpdateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingBottom="6dp"
                android:textColor="?attr/auroraTextSecondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 更新日志：左对齐，内容较长时在滚动区内上下滑 -->
            <TextView
                android:id="@+id/tvUpdateBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/auroraTextPrimary"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.aurora.app.ui.widget.MaxHeightScrollView>

    <!-- 操作（固定，永远在卡片底部可见）：两枚按钮等宽，单按钮时铺满整行 -->
    <LinearLayout
        android:id="@+id/llUpdateActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateLater"
            style="@style/Widget.Aurora.Miuix.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="知道了" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateNow"
            style="@style/Widget.Aurora.Miuix.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="立即更新"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
