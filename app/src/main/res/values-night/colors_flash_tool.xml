<?xml version="1.0" encoding="utf-8"?>
<!--
  「刷写分区」页的专用配色（深色）。

  需求只给了浅色规格，但这页同样会在深色 / AMOLED 主题下被打开。
  不给夜间的对应值，白卡片在深色系统里就是一块刺眼的亮斑。
  这里按浅色的层级关系重新排了一遍，强调色提亮以保证在深底上的对比度。
-->
<resources>
    <color name="flash_tool_bg">#0E1116</color>

    <color name="flash_tool_surface">#171B22</color>
    <color name="flash_tool_surface_alt">#1F242D</color>
    <color name="flash_tool_stroke">#2A303A</color>
    <color name="flash_tool_stroke_strong">#3A4250</color>

    <!-- 深底上 #3978ED 偏暗，提亮到 #6B9BFF 才够对比度 -->
    <color name="flash_tool_accent">#6B9BFF</color>
    <color name="flash_tool_accent_pressed">#5A87E8</color>
    <color name="flash_tool_accent_weak">#1C2A45</color>
    <color name="flash_tool_on_accent">#0E1116</color>

    <color name="flash_tool_text_primary">#ECEEF2</color>
    <color name="flash_tool_text_secondary">#98A2B3</color>
    <color name="flash_tool_text_hint">#6B7280</color>

    <color name="flash_tool_danger">#FF6B5E</color>
    <color name="flash_tool_danger_weak">#3A1F1C</color>
    <color name="flash_tool_success">#32D583</color>
    <color name="flash_tool_success_weak">#14301F</color>

    <!-- 深色下日志区比卡片再深一档，仍然是「凹进去」的一块 -->
    <color name="flash_tool_log_bg">#0B0E13</color>
    <color name="flash_tool_log_text">#C8CED8</color>

    <color name="flash_tool_progress_track">#2A303A</color>
</resources>
