<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗圆角背景：与 bg_toolbar_popup_menu 保持同一套视觉语言
  （20dp 圆角 + ios_background_elevated 填充 + 极淡描边），
  颜色资源自带 values-night 版本，深浅色主题自动适配。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/auroraBackgroundElevated" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/dialog_stroke" />
</shape>
