<?xml version="1.0" encoding="utf-8"?>
<!--
  宫格里图标底片：浅灰圆角方块。

  以前每一格是彩色底板（rose_100 / blue_100 …），一屏 12 种颜色，反而分不清主次；
  现在统一成「白卡 + 浅灰方块 + 强调色图标」，靠图标本身区分入口。
  颜色走 auroraFill，深浅色两套自动成立。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/auroraFill" />
    <corners android:radius="14dp" />
</shape>
