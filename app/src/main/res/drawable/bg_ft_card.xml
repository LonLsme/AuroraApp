<?xml version="1.0" encoding="utf-8"?>
<!--
  白色圆角卡片（18dp）+ 1dp 细描边。

  描边不是装饰：AMOLED 纯黑主题下卡片与页面背景可能同色，
  没有这 1dp 就只剩文字浮在纯黑上，看不出「这是一张卡」。
  这也是全项目新组件的统一要求（见 docs 里的 AMOLED 约定）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/flash_tool_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/flash_tool_stroke" />
    <corners android:radius="18dp" />
</shape>
