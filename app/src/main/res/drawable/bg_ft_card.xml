<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片底：主题卡片色 + 1dp 描边 + 18dp 圆角。

  颜色全部走主题（?attr/auroraCard）与 ios_separator —— 两者都有 values-night
  的对应值，切深色 / AMOLED 时自动跟随，不需要为本页单独维护一份配色。

  描边不是装饰：AMOLED 纯黑主题下卡片色与页面背景可能同色，
  没有这 1dp 就只剩文字浮在黑上，看不出「这是一张卡」。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/auroraCard" />
    <stroke
        android:width="1dp"
        android:color="?attr/auroraSeparator" />
    <corners android:radius="18dp" />
</shape>
