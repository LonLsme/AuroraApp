<?xml version="1.0" encoding="utf-8"?>
<!--
  输出框背景：卡片色填充 + 细描边 + 圆角。

  为什么不用 ?attr/auroraFill（= ios_fill_tertiary）：
  浅色模式下 auroraFill 是 #F2F2F7，而刷机子页面的页面背景
  （ios_background_grouped）恰好也是 #F2F2F7 —— 填充与背景同色，
  输出框会整个「隐形」，只剩文字浮在页面上。

  改为 auroraCard + ios_separator 描边后，三种色彩模式下边界都明确：
    浅色  #FFFFFF 底 + #E0E0E0 描边
    深色  #1C1C1E 底 + #38383A 描边
    AMOLED #000000 底 + #38383A 描边（靠描边区分于纯黑背景）

  两个色都不在「强调色覆盖层」的改写范围内，所以可以安全地直接引资源。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/auroraCard" />
    <stroke
        android:width="1dp"
        android:color="@color/ios_separator" />
    <corners android:radius="12dp" />
</shape>
