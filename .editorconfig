root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{xml,md}]
indent_size = 4
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.sh]
indent_size = 2
# shell 脚本必须保留可执行位，且换行符必须是 LF（CRLF 会让设备上的 sh 直接报错）
